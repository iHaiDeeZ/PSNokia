######################################################################
# Build options for the Vita/vitasdk MIDP port.
# Copied from ../linux_sdl_gcc/Options.gmk (known-working baseline).
######################################################################
# the VM
USE_CLDC_11             = true
BUILD_CLDC              = true
USE_MONET               = false
USE_VM_PROFILES         = false
# SSL
USE_SSL                 = false
USE_RESTRICTED_CRYPTO   = false
# JSRs
USE_JSR_75              = false
USE_JSR_82              = false
USE_JSR_120             = false
USE_JSR_135             = false
USE_JSR_172             = false
USE_JSR_177             = false
USE_JSR_179             = false
USE_JSR_180             = false
USE_JSR_184             = false
USE_JSR_205             = false
USE_JSR_211             = false
USE_JSR_226             = false
USE_PISCES              = false
USE_JSR_229             = false
USE_JSR_230             = false
USE_JSR_234             = false
USE_JSR_238             = false
USE_JSR_239             = false
# MIDP
USE_MULTIPLE_ISOLATES   = false
USE_STATIC_PROPERTIES   = true
USE_IMAGE_CACHE         = true
USE_ICON_CACHE          = true
USE_RMS_TREE_INDEX      = false
USE_NETWORK_INDICATOR   = true
USE_CLDC_RELEASE        = false
USE_NATIVE_AMS          = false
USE_RAW_AMS_IMAGES      = false
USE_NATIVE_PTI          = false
# DEBUG
USE_DEBUG               = false
USE_MIDP_MALLOC         = true
USE_JAVA_DEBUGGER       = false
USE_JAVA_PROFILER       = false
USE_NATIVE_PROFILER     = false
USE_NUTS_FRAMEWORK      = false
USE_VERBOSE_MAKE        = false
USE_I3_TEST             = false
USE_PORTING_DEMOS       = true
USE_CONTROL_ARGS_FROM_JAD       = false
USE_GCOV                = false
# USE_SERVER_SOCKET
USE_SERVER_SOCKET       = true
# JPEG decoding for putpixel
USE_JPEG=false
# RESOURCE MANAGEMENT POLICY
USE_FIXED               = false
# OPTIMIZATIONS
USE_VERIFY_ONCE         = false
# Links
USE_LINKS               = true
# ABB
USE_MIDP_ABB            = false
