#!/bin/bash
# phoneME's build expects a gcc-style driver. Compiles with clang for the
# PS4 (x86_64 FreeBSD ELF, OpenOrbis sysroot); links like the OpenOrbis
# samples do (ld.lld + link.x + crt1.o).
OO=${OO_PS4_TOOLCHAIN:?source ps4/env.sh first}
LLVM=${PS4_LLVM:?source ps4/env.sh first}
TARGET="--target=x86_64-pc-freebsd12-elf -fPIC -funwind-tables -isysroot $OO -isystem $OO/include"

case "$(basename "$0")" in
  # phoneME predates C++17 ('register' etc.)
  g++) DRIVER="$LLVM/bin/clang++"; TARGET="$TARGET -isystem $OO/include/c++/v1 -std=gnu++14" ;;
  *)   DRIVER="$LLVM/bin/clang" ;;
esac

compile=0
for a in "$@"; do
  case "$a" in -c|-S|-E|-M|-MM) compile=1 ;; esac
done

if [ $compile = 1 ]; then
  # gcc-only warning switches would make clang print noise; drop them
  args=()
  for a in "$@"; do
    case "$a" in
      -Wno-error=stringop-overflow|-Wno-error=maybe-uninitialized|-Wno-error=register) ;;
      -fno-optional-diags) ;;
      # MIDP's release flags: gcc-only, and -s belongs to the link
      -fexpensive-optimizations|-fconserve-space|-s) ;;
      *) args+=("$a") ;;
    esac
  done
  # The VM type-puns heap words all over; don't let clang assume otherwise.
  # Its operator new returns NULL on failure, so keep the NULL checks.
  # -fms-extensions: __ptr32 for 4-byte Java references in ROMStructs.h
  exec "$DRIVER" $TARGET "${args[@]}" -fno-strict-aliasing -fcheck-new -fms-extensions
fi

# Link: keep objects, archives, -o, -L, -l; translate -Wl,a,b; drop the rest
args=()
while [ $# -gt 0 ]; do
  case "$1" in
    -o) args+=("-o" "$2"); shift ;;
    -o*) args+=("-o" "${1#-o}") ;;
    -L*|-l*) args+=("$1") ;;
    -Wl,*) IFS=',' read -ra parts <<< "${1#-Wl,}"; args+=("${parts[@]}") ;;
    *.o|*.a|*.obj) args+=("$1") ;;
    *) ;;
  esac
  shift
done
exec "$LLVM/bin/ld.lld" -m elf_x86_64 -pie --script "$OO/link.x" --eh-frame-hdr \
  -L"$OO/lib" "${args[@]}" -lc -lkernel -lc++ "$OO/lib/crt1.o"
